{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Humanoid Companion",
  "version": "0.1.0",
  "identifier": "ai.humanoid.companion",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:5173", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": {
    "windows": [
      { "label": "main", "title": "Humanoid Companion", "url": "index.html", "width": 1200, "height": 800, "minWidth": 760, "minHeight": 500, "visible": false },
      { "label": "mini", "title": "Companion", "url": "index.html?view=mini", "width": 380, "height": 560, "minWidth": 320, "minHeight": 360,
        "alwaysOnTop": true, "decorations": false, "transparent": true, "skipTaskbar": true, "resizable": true, "visible": true }
    ],
    "trayIcon": { "id": "main", "iconPath": "icons/icon.png", "tooltip": "Humanoid Companion" },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 ws://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "active": true, "targets": "all", "externalBin": ["binaries/hc-backend"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
